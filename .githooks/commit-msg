#!/usr/bin/env bash
# commit-msg 钩子：强制 docs/Implementation-Plan.md §1 的提交信息格式。
#
# 安装：git config core.hooksPath .githooks
#
# 阻断项（exit 1）：
#   - 首行超过 72 字符
#   - 首行不符合 type[module]: subject
#   - subject 结尾带句号
# 提醒项（不阻断）：
#   - subject 中出现 " and "，提示可能需要拆分提交
set -euo pipefail

msg_file="$1"
subject="$(head -n 1 "$msg_file")"
# Windows 下 git 可能写入 CRLF；先去掉行尾 CR，避免长度与结尾判断被干扰。
subject="${subject%$'\r'}"

if [ "${#subject}" -gt 72 ]; then
    printf 'commit-msg: 首行 %d 字符，超过 72 字符上限\n' "${#subject}" >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

if ! printf '%s' "$subject" | grep -Eq \
    '^(feat|fix|refactor|perf|test|bench|docs|build|ci|chore|style|revert)\[[a-z0-9]+(/[a-z0-9]+)?\]: [a-z0-9].*$'; then
    cat >&2 <<'EOF'
commit-msg: 提交信息格式不符

  期望：type[module]: lowercase english subject
  示例：feat[cavlc]: add residual block decoding with level prefix

  type  : feat fix refactor perf test bench docs build ci chore style revert
  module: repo errors frame packet config bitstream nal syntax picture dpb
          cavlc cabac prediction transform motion filter simd buffer
          decoder encoder stream cmd deps oracle testdata fuzz bench release
          status roadmap architecture performance conformance api legal readme
EOF
    printf '  实际：%s\n' "$subject" >&2
    exit 1
fi

case "$subject" in
    *.)
        printf 'commit-msg: subject 不能以句号结尾\n' >&2
        exit 1
        ;;
esac

case "$subject" in
    *" and "*)
        printf 'commit-msg: 提醒：subject 含 "and"，确认是否应拆成两个提交\n' >&2
        ;;
esac

# 破坏性改动的提示：body 中没有 Breaking: 却改了公共 API 的情况由 review 兜底。
exit 0
